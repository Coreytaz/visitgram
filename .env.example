VISITGRAM_SQLITE_URL="file:./analytics.db"
# Database selection: sqlite, libsql, postgresql, mysql, singlestore, mssql, cockroachdb.
# SQLite is the default; VISITGRAM_SQLITE_URL sets its local file URL.
VISITGRAM_DB_DIALECT="sqlite"
# Optional for SQLite; required for other dialects. Takes precedence over VISITGRAM_SQLITE_URL.
VISITGRAM_DATABASE_URL=""
# Only for remote libSQL/Turso:
VISITGRAM_DATABASE_AUTH_TOKEN=""
VISITGRAM_PORT_SERVER="3000"
VISITGRAM_PUBLIC_URL="http://localhost:3000"
VISITGRAM_TOKEN="CHANGE_TO_A_LONG_RANDOM_ADMIN_TOKEN"
# Optional one-time import for the first launch; manage sites in Telegram afterwards.
VISITGRAM_ALLOWED_ORIGINS=""
VISITGRAM_TRACK_RETENTION_DAYS="30"
# Comma-separated trusted reverse proxy IPs. Empty disables forwarded IPs.
# The proxy must append or overwrite X-Forwarded-For; keep the app port private.
VISITGRAM_TRUSTED_PROXIES="127.0.0.1,::1"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_EVENTS="pageview,click"

# Optional HTTP proxy, if required on this computer:
# HTTPS_PROXY=http://127.0.0.1:2080
# NO_PROXY=localhost,127.0.0.1

# Language for notifications and the startup menu (ru or en).
# Interactive replies use the Telegram user language, falling back to Russian.
TELEGRAM_LOCALE="ru"
